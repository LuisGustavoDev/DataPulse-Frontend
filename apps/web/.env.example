# Copie para .env.local. Nenhuma variável é obrigatória em dev.

# Origem da API NestJS. Em dev, /api/v1/* é repassado para cá (padrão: http://localhost:3001).
# Em produção o ingress faz esse papel; só defina se o Next também for o proxy.
API_ORIGIN=http://localhost:3001

# Origem do serviço realtime (SSE). Em dev, /sse/v1/* é repassado para cá (padrão: http://localhost:3002).
SSE_ORIGIN=http://localhost:3002

# Origem do MinIO vista pelo navegador. Entra no connect-src da CSP em produção, porque
# as partes do upload vão direto do navegador para o storage (ADR 03).
STORAGE_ORIGIN=http://localhost:9000
